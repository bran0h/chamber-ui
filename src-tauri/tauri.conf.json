{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chamber-ui",
  "version": "0.1.0",
  "identifier": "com.branislavhozza.chamber-ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "chamber-ui",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNkE5RjlEN0Y2Njk2N0QKUldSOWxtWi9uWjlxamhiYjhZZXpneW1PcEMxSWY3UlNSNm9lc3BXWTUrZUhBbUJLaWU2T20yOG0K",
      "endpoints": [
        "https://bc599eca90fbab8fb9e2097161292fcf.r2.cloudflarestorage.com/chamber-ui-builds/release/{{target}}/{{arch}}/latest.json"
      ]
    }
  }
}
